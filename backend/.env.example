# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=

# MySQL connection string
DATABASE_URL=mysql+mysqlconnector://complaint_user:Sai@8830@localhost:3306/complaint_db

# Upload directory (relative to backend/)
UPLOAD_DIR=uploads

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Rate limit: max requests per minute for chat/upload endpoints
RATE_LIMIT_PER_MINUTE=20

# LLM models
LLM_MODEL_PRIMARY=openai/gpt-oss-20b
LLM_MODEL_LARGE_CONTEXT=openai/gpt-oss-120b

# Debug mode (reload on change)
DEBUG=false
